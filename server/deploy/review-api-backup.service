[Unit]
Description=Review SQLite consistent daily backup
After=review-api.service

[Service]
Type=oneshot
User=review-api
Group=review-api
EnvironmentFile=/etc/review-api.env
ExecStart=/opt/review-api/backup.sh
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/review-api /var/backups/review-api

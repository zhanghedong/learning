# Add inside the existing HTTPS server block; leave /api/sync/ on the old Python service.
location /api/v1/ {
    client_max_body_size 256k;
    proxy_pass http://127.0.0.1:3108;
    proxy_connect_timeout 5s;
    proxy_read_timeout 35s;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto https;
    # Do not put Authorization, request bodies or query strings into access logs.
}
# /healthz is deliberately not exposed publicly in this example.

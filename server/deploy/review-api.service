[Unit]
Description=Review Account API (Go)
After=network.target

[Service]
Type=simple
User=review-api
Group=review-api
WorkingDirectory=/opt/review-api
EnvironmentFile=/etc/review-api.env
ExecStart=/opt/review-api/review-api
Restart=on-failure
RestartSec=3
StateDirectory=review-api
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/review-api

[Install]
WantedBy=multi-user.target

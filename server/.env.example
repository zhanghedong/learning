REVIEW_ADDR=127.0.0.1:3108
REVIEW_DB=/var/lib/review-api/review.db
# Required: set to a stable random secret of at least 32 bytes (e.g. openssl rand -hex 32).
REVIEW_CODE_SECRET=
# Optional SMTP STARTTLS, usually port 587. Empty disables self-registration/recovery.
REVIEW_SMTP_ADDR=
REVIEW_SMTP_FROM=
REVIEW_SMTP_USER=
REVIEW_SMTP_PASSWORD=
